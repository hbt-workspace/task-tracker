<Window x:Class="TaskTrackerBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTrackerBot"
        mc:Ignorable="d"
        Title="Task Tracker Bot"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Your UI -->
    <Border Background="#CC1E1E1E"
            CornerRadius="15"
            BorderBrush="#404040"
            BorderThickness="1"
            Padding="20"
            Opacity="0.99">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock Text="Task Tracker Bot"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>

                <!-- Close Button -->
                <Button Content="✕"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="Foreground"
                                    Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#E81123"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center"
                            Margin="10">

                    <TextBlock Text="STEP 1 OF 3"
                               Foreground="#A5B4FC"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="What did you do yesterday?"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Describe the work you completed."
                               Foreground="#BDBDBD"
                               FontSize="14"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBox x:Name="AnswerTextBox"
                             Height="100"
                             Margin="0,20,0,0"
                             Padding="10"
                             FontSize="14"
                             Foreground="White"
                             Background="#292929"
                             BorderBrush="#555555"
                             CaretBrush="White"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>

                    <Button x:Name="NextButton"
                            Content="Next →"
                            Width="120"
                            Height="38"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Right"
                            Background="#6366F1"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="NextButton_Click"/>
                </StackPanel>
            </Grid>

        </Grid>

    </Border>
</Window>

