<Window x:Class="TaskTrackerBot.MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTrackerBot"
        mc:Ignorable="d"
        Height="320"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Border Background="#E61E1E1E"
            BorderBrush="#303544"
            BorderThickness="1"
            CornerRadius="18"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">

                <Border Name="IconBorder"
                        Width="68"
                        Height="68"
                        CornerRadius="34"
                        Background="#173D32"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <TextBlock Name="IconTextBlock"
                               Text="✔"
                               Foreground="#4ADE80"
                               FontSize="36"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Name="MessageTextBlock"
                           Text="Report submitted!"
                           Foreground="#F4F5FB"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Name="DescriptionTextBlock"
                           Text="Your daily report has been sent successfully."
                           Foreground="#A3AAC0"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

            </StackPanel>

            <Button Grid.Row="1"
                    Content="Ok"
                    Height="42"
                    Margin="0,20,0,0"
                    Background="#6366F1"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OkButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>
    </Border>
</Window>

