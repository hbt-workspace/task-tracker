@{
    ViewData["Title"] = "Privacy Policy";
}

<link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />

<div class="privacy-page">

    <!-- Page Header -->
    <header class="privacy-hero">
        <div class="privacy-hero-content">
            <div class="privacy-brand-label">
                <i class="bi bi-shield-check"></i>
                HBT WORKSPACE
            </div>

            <h1>Privacy Policy</h1>

            <p class="privacy-hero-description">
                Our commitment to responsible information handling,
                confidentiality, and the professional use of Task Tracker.
            </p>
        </div>

        <div class="privacy-hero-symbol">
            <i class="bi bi-shield-lock"></i>
        </div>
    </header>

    <!-- Introduction -->
    <section class="privacy-introduction">
        <span class="privacy-section-label">OUR PRIVACY COMMITMENT</span>

        <h2>Built on trust. Guided by responsibility.</h2>

        <p>
            HBT Workspace is a modern software development company dedicated
            to delivering high-quality, scalable, and innovative digital
            solutions. We specialize in custom web applications, enterprise
            systems, and user-friendly platforms tailored to business needs,
            with a focus on performance, reliability, and seamless user experience.
        </p>

        <p>
            This Privacy Policy describes the intended purpose of the Task Tracker
            application and the privacy principles relevant to employee work reports
            handled through the platform. It should be read alongside the actual
            data-handling practices and policies applicable to your organization.
        </p>
    </section>

    <!-- Policy Sections -->
    <div class="privacy-policy-layout">

        <aside class="privacy-sidebar">
            <div class="privacy-sidebar-icon">
                <i class="bi bi-journal-text"></i>
            </div>

            <h3>Policy Overview</h3>

            <p>
                Clear principles for the responsible use of work-related
                information within Task Tracker.
            </p>

            <div class="privacy-sidebar-divider"></div>

            <div class="privacy-sidebar-item">
                <i class="bi bi-building"></i>
                <span>HBT Workspace</span>
            </div>

            <div class="privacy-sidebar-item">
                <i class="bi bi-kanban"></i>
                <span>Task Tracker Application</span>
            </div>
        </aside>

        <div class="privacy-policy-sections">

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">01</div>

                <div class="privacy-policy-body">
                    <h2>Purpose of the Application</h2>

                    <p>
                        Task Tracker supports the recording, review, and reporting
                        of employee work updates. Its report fields include
                        yesterday's tasks, today's tasks, and obstacles affecting
                        work progress.
                    </p>

                    <p>
                        The application is intended to help support work planning,
                        progress visibility, coordination, and the identification
                        of work-related challenges.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">02</div>

                <div class="privacy-policy-body">
                    <h2>Information Handled</h2>

                    <p>
                        In the context of its task-reporting functionality,
                        the application may handle employee names, task updates,
                        reported obstacles, report dates, and related record
                        information.
                    </p>

                    <p>
                        Users should provide information relevant to work
                        activities and avoid including personal or confidential
                        information that is not necessary for the task-reporting
                        purpose.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">03</div>

                <div class="privacy-policy-body">
                    <h2>Use of Information</h2>

                    <p>
                        Work-report information is intended to support internal
                        business operations, review of reported tasks, progress
                        tracking, and identification of obstacles.
                    </p>

                    <p>
                        Information should be accessed and used only for
                        legitimate, authorized purposes consistent with the
                        organization's applicable policies.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">04</div>

                <div class="privacy-policy-body">
                    <h2>Access and Confidentiality</h2>

                    <p>
                        Employee reports can contain internal work information
                        and should be treated with appropriate care.
                        Access should be limited to individuals authorized
                        under the organization's access-control procedures.
                    </p>

                    <p>
                        Users are expected to handle reports responsibly and
                        avoid unauthorized viewing, copying, disclosure, or
                        distribution of their contents.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">05</div>

                <div class="privacy-policy-body">
                    <h2>Data Storage and Protection</h2>

                    <p>
                        Task Tracker uses its configured application data source
                        to support its reporting functionality. The specific
                        storage arrangements, security controls, backup procedures,
                        and access permissions depend on the deployed environment.
                    </p>

                    <p>
                        The organization should maintain appropriate safeguards
                        to protect information against unauthorized access,
                        alteration, disclosure, or loss.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">06</div>

                <div class="privacy-policy-body">
                    <h2>Data Retention and Record Management</h2>

                    <p>
                        Work reports should be retained, archived, or removed
                        according to the organization's approved retention
                        requirements and applicable obligations.
                    </p>

                    <p>
                        The retention period and record-management process
                        should be established by the organization based on
                        its operational and legal requirements.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">07</div>

                <div class="privacy-policy-body">
                    <h2>Organizational Responsibilities</h2>

                    <p>
                        HBT Workspace's commitment to reliable and user-friendly
                        digital solutions includes the importance of responsible
                        information handling. The organization operating Task
                        Tracker is responsible for ensuring that its deployment,
                        access permissions, data practices, and internal procedures
                        align with applicable requirements.
                    </p>

                    <p>
                        Users should follow their organization's policies when
                        entering, viewing, or handling employee work reports.
                    </p>
                </div>
            </section>

            <section class="privacy-policy-card">
                <div class="privacy-policy-number">08</div>

                <div class="privacy-policy-body">
                    <h2>Policy Scope and Review</h2>

                    <p>
                        This policy addresses the Task Tracker application's
                        employee-reporting context. Additional notices or
                        policies may apply to other systems, services, or
                        information-handling activities.
                    </p>

                    <p>
                        This policy should be reviewed whenever the application's
                        functionality, deployment, data practices, or applicable
                        requirements change.
                    </p>
                </div>
            </section>

        </div>
    </div>

    <!-- Closing Statement -->
    <footer class="privacy-closing">
        <div class="privacy-closing-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <h2>Privacy is part of responsible technology.</h2>

            <p>
                HBT Workspace is committed to developing digital solutions
                with a focus on quality, reliability, and user experience.
                Responsible handling of work-related information is an
                important part of operating Task Tracker.
            </p>

            <a href="https://hbtworkspace.in" class="privacy-company-link" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-globe2"></i>
                Visit HBT Workspace
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>
    </footer>

</div>
