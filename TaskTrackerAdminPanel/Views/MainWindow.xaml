<Window x:Class="TaskTrackerAdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTrackerAdminPanel"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <!-- Main Window Border -->
    <Border Background="#151821"
            BorderBrush="#303544"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Company Header -->
            <Border Grid.Row="0"
                    Background="#202432"
                    BorderBrush="#343A4B"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="24,10">

                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- HBT Logo -->
                    <Border Width="48"
                            Height="48"
                            CornerRadius="10"
                            Background="White"
                            Padding="3"
                            VerticalAlignment="Center">

                        <Image Source="/Assets/HBTLogo.ico"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Company Name -->
                    <StackPanel Grid.Column="1"
                                Margin="13,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="HBT WorkSpace"
                                   Foreground="#F4F5FB"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="TASK TRACKER"
                                   Foreground="#A5B4FC"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Search Button -->
                        <Button Height="38"
                                Padding="12,0"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"
                                ToolTip="Search employee reports"
                                Click="SearchButton_Click">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Path Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 11,11 L 16,16 M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7"/>

                                <TextBlock Text="Search"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#C5CAD8"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#343A4B"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                        <!-- Minimize Button -->
                        <Button Content="—"
                                Width="38"
                                Height="38"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                FontSize="20"
                                Cursor="Hand"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#FFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#64748B"/>
                                            <Setter Property="Foreground"
                                                    Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="MaximizeButton"
                                Content="□"
                                Width="38"
                                Height="38"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="17"
                                Cursor="Hand"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#C5CAD8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#343A4B"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Close Button -->
                        <Button Content="✕"
                                Width="38"
                                Height="38"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="17"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                ToolTip="Close">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#C5CAD8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#E5484D"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- Home Page Content -->
            <Grid Grid.Row="1"
                  Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Heading -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Today's Employee Reports"
                                   Foreground="#F4F5FB"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Review employee progress and daily updates."
                                   Foreground="#9CA3B8"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            Content="Refresh Reports"
                            Width="150"
                            Height="42"
                            VerticalAlignment="Center"
                            Background="#6366F1"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="RefreshReportsButton_Click"/>
                </Grid>

                <!-- Employee Report Cards -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="ReportsItemsControl">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#202432"
                                        BorderBrush="#343A4B"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="22"
                                        Margin="0,0,8,16">

                                    <StackPanel>

                                        <!-- Employee Information -->
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Employee Name and Report Date -->
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmployeeName}"
                                                           Foreground="#F4F5FB"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding ReportDate, StringFormat='Report date: {0:dd MMM yyyy, hh:mm tt}'}"
                                                           Foreground="#9299B0"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Submission Status -->
                                            <Border Grid.Column="1"
                                                    Background="#173D32"
                                                    CornerRadius="12"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Submitted"
                                                           Foreground="#4ADE80"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <Border Height="1"
                                                Background="#383E50"
                                                Margin="0,0,0,18"/>

                                        <!-- Task Details -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,16,0">
                                                <TextBlock Text="YESTERDAY'S TASK"
                                                           Foreground="#A5B4FC"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding YesterdaysTask}"
                                                           Foreground="#E2E5F0"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,16,0">
                                                <TextBlock Text="TODAY'S TASK"
                                                           Foreground="#A5B4FC"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding TodaysTask}"
                                                           Foreground="#E2E5F0"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Margin="8,0,0,0">
                                                <TextBlock Text="OBSTACLES"
                                                           Foreground="#FBBF24"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Obstacle}"
                                                           Foreground="#E2E5F0"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>