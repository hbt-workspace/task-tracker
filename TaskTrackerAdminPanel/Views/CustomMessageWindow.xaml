<Window x:Class="TaskTrackerAdminPanel.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Tracker"
        Width="390"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="#E6202432"
            BorderBrush="#803A4155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22">

        <StackPanel>

            <!-- Dialog Header -->
            <DockPanel Margin="0,0,0,22">

                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="30"
                        Height="30"
                        Background="Transparent"
                        Foreground="#C5CAD8"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        ToolTip="Close"
                        Click="CloseButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="CloseBorder"
                                            Property="Background"
                                            Value="#E5484D"/>
                                    <Setter Property="Foreground"
                                            Value="#FFFFFF"/>
                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="CloseBorder"
                                            Property="Background"
                                            Value="#C9363E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="TASK TRACKER"
                           Foreground="#A5B4FC"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Message Content -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,24">

                <!-- Warning Icon -->
                <Border Width="46"
                        Height="46"
                        CornerRadius="12"
                        Background="#493923"
                        Margin="0,0,15,0">

                    <TextBlock Text="!"
                               Foreground="#FBBF24"
                               FontSize="27"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Message Title and Description -->
                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="MessageTitleText"
                               Text="Date Required"
                               Foreground="#F4F5FB"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="MessageText"
                               Text="Please select both From Date and To Date."
                               Foreground="#C5CAD8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MaxWidth="270"/>
                </StackPanel>
            </StackPanel>

            <!-- OK Button -->
            <Button Content="OK"
                    Width="90"
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="#6366F1"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="CloseButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OkBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="OkBorder"
                                        Property="Background"
                                        Value="#7779FF"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="OkBorder"
                                        Property="Background"
                                        Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>
