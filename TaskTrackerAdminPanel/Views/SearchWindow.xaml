<Window x:Class="TaskTrackerAdminPanel.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTrackerAdminPanel"
        mc:Ignorable="d"
        Title="Search Employee Reports"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <!-- Main Window Border -->
    <Border Background="#151821"
            BorderBrush="#303544"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Company Navbar -->
            <Border Grid.Row="0"
                    Background="#202432"
                    BorderBrush="#343A4B"
                    BorderThickness="0,0,0,1"
                    Padding="24,10">

                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- HBT Logo -->
                    <Border Width="48"
                            Height="48"
                            CornerRadius="10"
                            Background="White"
                            Padding="3"
                            VerticalAlignment="Center">

                        <Image Source="/Assets/HBTLogo.ico"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Company Name -->
                    <StackPanel Grid.Column="1"
                                Margin="13,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="HBT WorkSpace"
                                   Foreground="#F4F5FB"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="TASK TRACKER"
                                   Foreground="#A5B4FC"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Navigation and Window Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- Home Button -->
                        <Button Height="38"
                                Padding="12,0"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"
                                ToolTip="Return to Employee Reports"
                                Click="HomeButton_Click">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Path Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1,8 L 9,1 L 17,8 M 3,7 L 3,17 L 7,17 L 7,11 L 11,11 L 11,17 L 15,17 L 15,7"/>

                                <TextBlock Text="Home"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="#C5CAD8"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#343A4B"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                        <!-- Minimize Button -->
                        <Button Content="—"
                                Width="38"
                                Height="38"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                FontSize="20"
                                Cursor="Hand"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click"/>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="MaximizeButton"
                                Content="□"
                                Width="38"
                                Height="38"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="17"
                                Cursor="Hand"
                                ToolTip="Maximize"
                                Click="MaximizeButton_Click"/>

                        <!-- Close Button -->
                        <Button Content="✕"
                                Width="38"
                                Height="38"
                                Background="Transparent"
                                Foreground="#C5CAD8"
                                BorderThickness="0"
                                FontSize="17"
                                Cursor="Hand"
                                ToolTip="Close"
                                Click="CloseButton_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search Page Content -->
            <Grid Grid.Row="1"
                  Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Heading -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,24">

                    <TextBlock Text="Search Employee Reports"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#F4F5FB"/>

                    <TextBlock Text="Find employee reports by name and date range."
                               FontSize="13"
                               Foreground="#9CA3B8"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Search Filters -->
                <Border Grid.Row="1"
                        Background="#202432"
                        BorderBrush="#343A4B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Employee Dropdown -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Employee"
                                       FontSize="12"
                                       Foreground="#A5B4FC"
                                       Margin="0,0,0,8"/>

                            <ComboBox x:Name="EmployeeComboBox"
                                      Height="40"
                                      Padding="8,4"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="UserName"
                                      SelectedValuePath="Id"
                                      ToolTip="Select employee"/>
                        </StackPanel>

                        <!-- From Date -->
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="From Date"
                                       FontSize="12"
                                       Foreground="#A5B4FC"
                                       Margin="0,0,0,8"/>

                            <DatePicker x:Name="FromDatePicker"
                                        Height="40"
                                        VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">

                            <TextBlock Text="To Date"
                                       FontSize="12"
                                       Foreground="#A5B4FC"
                                       Margin="0,0,0,8"/>

                            <DatePicker x:Name="ToDatePicker"
                                        Height="40"
                                        VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Search Button -->
                        <Button Grid.Column="3"
                                Content="Search"
                                Width="100"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Background="#6366F1"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="SearchReportsButton_Click"/>
                    </Grid>
                </Border>

                <!-- Search Results -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="SearchResultsItemsControl">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <!-- One Card Per Report Date -->
                                <Border Background="#202432"
                                        BorderBrush="#343A4B"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,18">

                                    <StackPanel>

                                        <!-- Report Date Heading with Employee Counter -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Date on the Left -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key, StringFormat='Date: {0:dd-MM-yyyy}'}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F4F5FB"
                                                       VerticalAlignment="Center"/>

                                            <!-- Employee Counter on the Right -->
                                            <Border Grid.Column="1"
                                                    Background="#303750"
                                                    BorderBrush="#454D68"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,7"
                                                    VerticalAlignment="Center">

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="EMPLOYEES"
                                                               Foreground="#A5B4FC"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <TextBlock Text="{Binding Count}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>


                                        <!-- Table Header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="NAME"
                                                       Foreground="#A5B4FC"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="YESTERDAY'S TASK"
                                                       Foreground="#A5B4FC"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="8,0,10,0"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="TODAY'S TASK"
                                                       Foreground="#A5B4FC"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="8,0,10,0"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="OBSTACLE"
                                                       Foreground="#FBBF24"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="8,0,0,0"/>
                                        </Grid>

                                        <Border Height="1"
                                                Background="#383E50"
                                                Margin="0,0,0,4"/>

                                        <!-- Employee Rows For This Date -->
                                        <ItemsControl ItemsSource="{Binding}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border BorderBrush="#343A4B"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,12">

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding EmployeeName}"
                                                                       Foreground="#F4F5FB"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,10,0"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding YesterdaysTask}"
                                                                       Foreground="#E2E5F0"
                                                                       FontSize="13"
                                                                       TextWrapping="Wrap"
                                                                       Margin="8,0,10,0"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding TodaysTask}"
                                                                       Foreground="#E2E5F0"
                                                                       FontSize="13"
                                                                       TextWrapping="Wrap"
                                                                       Margin="8,0,10,0"/>

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Obstacle}"
                                                                       Foreground="#E2E5F0"
                                                                       FontSize="13"
                                                                       TextWrapping="Wrap"
                                                                       Margin="8,0,0,0"/>

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>